<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ru.loper</groupId>
    <artifactId>SunCore</artifactId>
    <version>1.0.4.3-RELEASE</version>
    <packaging>jar</packaging>

    <name>SunCore</name>

    <properties>
        <java.version>16</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <paper.version>1.16.5-R0.1-SNAPSHOT</paper.version>
        <paper.group>com.destroystokyo.paper</paper.group>
        <paper.artifact>paper-api</paper.artifact>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.4</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
        <repository>
            <id>minecraft-repo</id>
            <url>https://libraries.minecraft.net/</url>
        </repository>
        <repository>
            <id>z-jitpack</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- ОДНА зависимость Paper - все параметры управляются через профиль -->
        <dependency>
            <groupId>${paper.group}</groupId>
            <artifactId>${paper.artifact}</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>authlib</artifactId>
            <version>1.5.21</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.gitlab.ruany</groupId>
            <artifactId>LiteBansAPI</artifactId>
            <version>0.6.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
            <version>6.7.1.RELEASE</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>ru.leymooo</groupId>
            <artifactId>antirelog</artifactId>
            <version>3.0.11</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/antirelog-3.0.11.jar</systemPath>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>paper-1.16</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <paper.version>1.16.5-R0.1-SNAPSHOT</paper.version>
                <paper.group>com.destroystokyo.paper</paper.group>
                <paper.artifact>paper-api</paper.artifact>
                <java.version>16</java.version>
            </properties>
        </profile>

        <profile>
            <id>paper-1.17</id>
            <properties>
                <paper.version>1.17.1-R0.1-SNAPSHOT</paper.version>
                <paper.group>io.papermc.paper</paper.group>
                <paper.artifact>paper-api</paper.artifact>
                <java.version>16</java.version>
            </properties>
        </profile>

        <profile>
            <id>paper-1.18</id>
            <properties>
                <paper.version>1.18.2-R0.1-SNAPSHOT</paper.version>
                <paper.group>io.papermc.paper</paper.group>
                <paper.artifact>paper-api</paper.artifact>
                <java.version>17</java.version>
            </properties>
        </profile>

        <profile>
            <id>paper-1.19</id>
            <properties>
                <paper.version>1.19.4-R0.1-SNAPSHOT</paper.version>
                <paper.group>io.papermc.paper</paper.group>
                <paper.artifact>paper-api</paper.artifact>
                <java.version>17</java.version>
            </properties>
        </profile>

        <profile>
            <id>paper-1.20</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <paper.version>1.20.4-R0.1-SNAPSHOT</paper.version>
                <paper.group>io.papermc.paper</paper.group>
                <paper.artifact>paper-api</paper.artifact>
                <java.version>17</java.version>
            </properties>
        </profile>

        <profile>
            <id>paper-1.21</id>
            <properties>
                <paper.version>1.21-R0.1-SNAPSHOT</paper.version>
                <paper.group>io.papermc.paper</paper.group>
                <paper.artifact>paper-api</paper.artifact>
                <java.version>21</java.version>
            </properties>
        </profile>
    </profiles>
</project>